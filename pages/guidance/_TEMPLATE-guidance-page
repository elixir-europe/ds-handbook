---
# ============================================================================
# Guidance (signpost) template
# Copy this file into pages/guidance/<your-page>.md and fill it in.
# Required fields are marked (mandatory). Everything else is optional but
# encouraged – the more you fill in, the more useful the case is to others.
#
# Some fields use a controlled vocabulary – you set a key, and the layout
# looks up the human-readable label from a YAML in _data/guidance/.
# If you need a value that isn't there, propose it in your PR.
# ============================================================================

title: "Guidance title"            # mandatory – short, specific
layout: page                       # mandatory – leave as-is
type: Guidance                     # mandatory – leave as-is
search_exclude: true               # – leave as-is

# 20–30 words. Used in meta tags, search results, and the highlights box at
description: One or two sentences capturing the core outcome or insight of this page.

contributors: [Your Name]          # mandatory – names must match _data/CONTRIBUTORS.yaml
page_id: g-shortname               # mandatory – lowercase, hyphenated

# ---------------------------------------------------------------------------
# Top card – populates the box at the top of the page. Easier to write last, once the rest of the page exists.
  # first tab
outcomes:                          # mandatory – Write this once you have finished the page 2-3 bullet points containing the main outcomes for the reader after going through the content on this page. Include important keywords that will be useful for the user but also for search engine optimisation. 
  - outcome 1
  - outcome 2
difficulty:                        # mandatory – need to decide in a yaml file the levels of difficulty
who-to-involve:                    # optional – name a list of roles/people – need to create a controlled vocabulary inside _data/guidance

  # second tab
why:                               # mandatory – 2-3 sentences on why this topic is important for a data steward to work on it

# ---------------------------------------------------------------------------
# Cross-references – rendered as a "Related pages" block at the bottom.
# Nested by type; each section becomes a row of slim tone-aware tiles.
# Type keys recognised: Guidance, Case_Study, Maturity_Indicator.
related_pages:
  Guidance:
    - g-writing-rdm-strategy
  Case_Study:
    - other-case-shortname
  Maturity_Indicator:
    - mm-strategy-defined

# ---------------------------------------------------------------------------
# Resources – render as tables (Templates / Internal /
# External) at the end of the page. 

# Add an inline entry resources:
#  - name: "Resource title"
#    url: https://example.org/resource
#    description: One-line context.
#    category: external_resource   # or template, internal_resource
# ---------------------------------------------------------------------------
resources:
  - name: rdmkit
    url: https://example.org/resource
    description: One-line context – why this resource matters here.
---


