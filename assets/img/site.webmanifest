---
# Front matter so Jekyll renders the Liquid below: the name tracks site.title,
# and relative_url keeps the icon paths correct under a baseurl (the Actions
# build passes --baseurl). RealFaviconGenerator's default pointed these at the
# site root, where the files don't live.
layout: none
# _config.yml sets `permalink: /:basename` for all pages, which would
# publish this at /site.webmanifest — pin it where the <link> points.
permalink: /assets/img/site.webmanifest
---
{
  "name": {{ site.title | jsonify }},
  "short_name": "DS Handbook",
  "icons": [
    {
      "src": {{ "/assets/img/web-app-manifest-192x192.png" | relative_url | jsonify }},
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": {{ "/assets/img/web-app-manifest-512x512.png" | relative_url | jsonify }},
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "theme_color": "#1b5f68",
  "background_color": "#ECF2F3",
  "display": "standalone"
}
